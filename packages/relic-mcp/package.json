{
  "name": "relic-mcp",
  "version": "0.3.0",
  "description": "Publish a file as an encrypted relic. The key is generated on your machine and never sent to the service.",
  "license": "MIT",
  "type": "module",
  "main": "dist/relic-mcp.js",
  "bin": {
    "relic-mcp": "dist/relic-mcp.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "encryption",
    "zero-knowledge",
    "file-sharing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBushidoCollective/relik.git",
    "directory": "packages/relic-mcp"
  },
  "homepage": "https://github.com/TheBushidoCollective/relic#readme",
  "bugs": {
    "url": "https://github.com/TheBushidoCollective/relic/issues"
  },
  "files": [
    "dist",
    "native",
    "prebuilds",
    "src",
    "scripts",
    "README.md",
    ".claude-plugin",
    "skills",
    "mcp-servers.json"
  ],
  "relicNativeSecureOpen": {
    "abiVersion": 1,
    "napiVersion": 8,
    "prebuilds": {
      "darwin-arm64": {
        "macOSBinaryDeploymentFloor": "15.0"
      },
      "darwin-x64": {
        "macOSBinaryDeploymentFloor": "15.0"
      },
      "linux-arm64-gnu": {
        "minimumGlibc": "2.28"
      },
      "linux-x64-gnu": {
        "minimumGlibc": "2.28"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node native/local-build.mjs && bun run build:bundle",
    "build:bundle": "bun run build.ts",
    "native:build": "node native/build.mjs",
    "native:check": "node native/build.mjs --check",
    "native:local": "node native/local-build.mjs",
    "prepack": "node native/build.mjs --check --metadata-only --release"
  },
  "devDependencies": {
    "@relic/format": "workspace:*",
    "@relic/server": "workspace:*",
    "@relic/viewer": "workspace:*",
    "pdf-lib": "^1.17.1"
  }
}
