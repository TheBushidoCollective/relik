+class IndirectObjectLexer extends Lexer {
+  // Ends an indirect object at its top-level endobj. Parser keeps one token of
+  // lookahead, which otherwise lexes whatever follows the object and, on a
+  // range-loaded document, fetches all of it first.
+  #depth = 0;
+  #ended = false;
+  getObj() {
+    if (this.#ended) {
+      return EOF;
+    }
+    const obj = super.getObj();
+    if (obj instanceof Cmd) {
+      switch (obj.cmd) {
+        case "<<":
+        case "[":
+          this.#depth++;
+          break;
+        case ">>":
+        case "]":
+          this.#depth--;
+          break;
+        case "endobj":
+          this.#ended = this.#depth === 0;
+          break;
+      }
+    }
+    return obj;
+  }
+}
